NODE_ENV=development
PORT=4000
APP_NAME=LoanEx API
API_PREFIX=/api/v1

# Supabase PostgreSQL connection string
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT secrets (change in production)
JWT_ACCESS_SECRET=loanex_dev_access_secret_change_me_32chars
JWT_REFRESH_SECRET=loanex_dev_refresh_secret_change_me_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_DEV_ECHO=true

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=60
VERIFICATION_RATE_LIMIT_MAX=120

# Razorpay (use test keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR
GST_PERCENT=18
# Local only: simulate checkout without live Razorpay keys
PAYMENT_DEV_BYPASS=true
